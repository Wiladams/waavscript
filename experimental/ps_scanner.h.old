//  ps_scanner.h
#pragma once

#include <functional>

#include "pscore.h"
#include "ps_lex_tokenizer.h"
#include "typeconv.h"

//
// The scanner's job is to convert a stream of lexemes into a stream of PSObjects
// Chapter 2 of Blue Book
//

namespace waavs
{

    using PSNameResolver = bool (*)(void* context, const PSName& name, PSObject& out);

    struct PSObjectGenState
    {
        PSLexGenState fLexState;
        void* fResolverContext{ nullptr };
        PSNameResolver fResolver{ nullptr };


        PSObjectGenState(const PSFileHandle file, void* context, PSNameResolver resolver)
            : fLexState(file),
            fResolverContext(context),
            fResolver(resolver)
        {}

    };


    bool resolveNameImmediately(PSObjectGenState& state, const PSName& name, PSObject& out)
    {
        return state.fResolver && state.fResolver(state.fResolverContext, name, out);
    }

    static bool spanToString(OctetCursor oc, std::vector<uint8_t>& result)
    {
        const uint8_t* src = oc.data();
        const size_t len = oc.size();

        result.clear();
        result.reserve(len);

        for (size_t i = 0; i < len; ++i) {
            uint8_t ch = src[i];

            if (ch == '\\') {
                if (i + 1 >= len)
                    continue;

                uint8_t next = src[++i];

                switch (next) {
                case 'n': result.push_back('\n'); break;
                case 'r': result.push_back('\r'); break;
                case 't': result.push_back('\t'); break;
                case 'b': result.push_back('\b'); break;
                case 'f': result.push_back('\f'); break;

                case '\\': result.push_back('\\'); break;
                case '(': result.push_back('('); break;
                case ')': result.push_back(')'); break;

                case '\n':
                    break;

                case '\r':
                    if (i + 1 < len && src[i + 1] == '\n')
                        ++i;
                    break;

                default:
                    if (next >= '0' && next <= '7') {
                        unsigned value = next - '0';

                        for (int count = 1; count < 3 && i + 1 < len; ++count) {
                            uint8_t digit = src[i + 1];
                            if (digit < '0' || digit > '7')
                                break;

                            value = (value << 3) | (digit - '0');
                            ++i;
                        }

                        result.push_back(static_cast<uint8_t>(value));
                    }
                    else {
                        result.push_back(next);
                    }
                    break;
                }

                continue;
            }

            if (ch == '\r') {
                if (i + 1 < len && src[i + 1] == '\n')
                    ++i;

                result.push_back('\n');
                continue;
            }

            result.push_back(ch);
        }

        return true;
    }

