%!PS-Adobe-3.0
%%Title: repeat: zero, count, named procedure
%%Pages: 0
%%EndComments
% Standalone control-flow diagnostic. No rendering required.
/Failures 0 def
/Checks 0 def
/Log { print (\n) print } bind def
/CheckEq {
  % actual expected label --
  /Label exch def /Expected exch def /Actual exch def
  /Checks Checks 1 add def
  (  CHECK ) print Label print (: actual=) print Actual ==
  (        expected=) print Expected ==
  Actual Expected eq
    { (        PASS) Log }
    { /Failures Failures 1 add def (        FAIL) Log } ifelse
} bind def
/CheckStack {
  % expected-depth label --  (use only with an otherwise empty operand stack)
  /Label exch def /Expected exch def /Actual count def
  Actual Expected Label CheckEq
} bind def
/Finish {
  (=== SUMMARY: ) print (01_repeat_basic.ps) print ( checks=) print Checks ==
  (=== failures=) print Failures ==
  Failures 0 eq { (=== PASS) Log } { (=== FAIL) Log } ifelse
} bind def
(=== BEGIN 01_repeat_basic.ps) Log

(phase: five increments) Log
/x 0 def
5 { /x x 1 add def (  tick x=) print x == } repeat
x 5 (five repeats) CheckEq
(phase: zero iterations) Log
/x 123 def
0 { /x 999 def } repeat
x 123 (zero repeats) CheckEq
(phase: named procedure scheduling) Log
/inc { /x x 1 add def } def
/x 0 def
10 { inc } repeat
x 10 (named procedure inside repeat) CheckEq

count 0 (operand stack clean before finish) CheckEq
Finish
%%EOF
